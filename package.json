{
  "name": "saasforge",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, reusable factory for launching and operating SaaS products.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:deploy": "pnpm --filter @saasforge/database db:deploy",
    "db:generate": "pnpm --filter @saasforge/database db:generate",
    "db:migrate": "pnpm --filter @saasforge/database db:migrate",
    "db:studio": "pnpm --filter @saasforge/database db:studio",
    "db:validate": "pnpm --filter @saasforge/database db:validate",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "forge:create": "pnpm --filter @saasforge/forge-cli run create",
    "factory:doctor": "pnpm --filter @saasforge/forge-cli run doctor",
    "factory:setup": "pnpm --filter @saasforge/forge-cli run setup",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
