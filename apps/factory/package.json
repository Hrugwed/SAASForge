{
  "name": "@saasforge/factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node start-factory.mjs dev loopback",
    "dev:network": "node start-factory.mjs dev hosted",
    "build": "next build",
    "start": "node start-factory.mjs start loopback",
    "start:hosted": "node start-factory.mjs start hosted",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@saasforge/auth": "workspace:*",
    "@saasforge/config": "workspace:*",
    "@saasforge/database": "workspace:*",
    "@saasforge/forge-cli": "workspace:*",
    "@saasforge/ui": "workspace:*",
    "better-auth": "^1.6.26",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
