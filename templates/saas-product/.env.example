# Copy this file into a generated product's ignored .env.local file.
# Every product owns unique credentials. Never reuse a production value.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://replace-me
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Enable only when this specific product needs billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEFAULT=
