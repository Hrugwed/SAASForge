NEXT_PUBLIC_APP_URL=http://localhost:3100
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
LOG_LEVEL=info

# Sentry is disabled when the DSN is empty. Configure a product-owned project before launch.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Enabled module flags are documented in src/lib/product-config.ts.
# Product-specific secrets are added only when their module is enabled.
