# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (local Docker default; use a Neon PostgreSQL URL in production)
DATABASE_URL=postgresql://saasforge:saasforge@127.0.0.1:5432/saasforge

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# factory:setup changes this only in the ignored local environment. Keep it
# disabled in hosted environments and configure the organization below.
SAASFORGE_LOCAL_OPERATOR_MODE=disabled

# Required when the private factory is hosted on a non-loopback URL. Only
# owners/admins of this organization can inspect the factory control plane.
SAASFORGE_OPERATOR_ORGANIZATION_ID=

# Product-specific provider values belong in each generated product, never in
# this private factory. See templates/saas-product/.env.example.
